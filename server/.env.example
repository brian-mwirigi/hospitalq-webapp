# Copy this file to .env and fill in the values.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/hospitalq

# JWT signing secret — local lab default, at least 32 characters. Change it if this machine is shared.
JWT_SECRET=hospitalq-local-dev-secret-32chars
JWT_EXPIRES_IN=8h

# Frontend URL (used for CORS and QR codes)
CLIENT_URL=http://localhost:5173

# bcrypt work factor
BCRYPT_SALT_ROUNDS=10

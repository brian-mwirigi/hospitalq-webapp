# Copy this file to .env and fill in the values.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/hospitalq

# JWT signing secret — local lab default, at least 32 characters. Change it if this machine is shared.
JWT_SECRET=hospitalq-local-dev-secret-32chars
JWT_EXPIRES_IN=8h

# Frontend URL (used for CORS and QR codes)
CLIENT_URL=http://localhost:5173

# bcrypt work factor
BCRYPT_SALT_ROUNDS=10

# Team 12 QuickFundi (upstream).
PARTNER_URL=https://team12-webapp-production.up.railway.app
PARTNER_API_KEY=
QUICKFUNDI_URL=https://team12-webapp-production.up.railway.app

# One key per consumer, comma-separated. Never commit the real values.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=replace-with-team1-key,replace-with-hospitalq-app-key

# 100 requests per key per minute. Count is in memory and resets on restart.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

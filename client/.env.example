# Copy this file to .env.local and fill in the values.
# Never commit .env.local (it can have secrets / local URLs).

# Base URL for all API calls (must include /api)
VITE_API_BASE_URL=http://localhost:5000/api

# Socket.io server URL (no /api)
VITE_SOCKET_URL=http://localhost:5000

# App display name
VITE_APP_NAME=HospitalQ

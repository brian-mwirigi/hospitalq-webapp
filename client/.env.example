# Copy this file to .env.local and fill in the values.
# Never commit .env.local (it can have secrets / local URLs).

# Base URL for all API calls (must include /api)
VITE_API_BASE_URL=http://localhost:5000/api

# Socket.io server URL (no /api)
VITE_SOCKET_URL=http://localhost:5000

# App display name
VITE_APP_NAME=HospitalQ

# Must match one value in the server API_KEYS list.
# This is the staff app key. It is visible in the browser. Do not put the partner key here.
VITE_API_KEY=replace-with-hospitalq-app-key

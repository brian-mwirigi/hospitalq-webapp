{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm install --prefix client && node -e \"require('fs').copyFileSync('openapi.yaml','client/public/openapi.yaml')\" && npm run build --prefix client",
  "installCommand": "npm install --prefix server",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/docs", "destination": "/api" },
    { "source": "/docs/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/docs",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/docs/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "openapi.yaml",
      "maxDuration": 15
    }
  }
}
